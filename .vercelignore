# .vercelignore — exclude large/unnecessary root directories without masking application routes.

# Large root directories not needed in production
download/
skills/
/audit/
tool-results/
examples/

# Dev-only files
dev.log
*.log

# Scripts not required by the Vercel build command
scripts/

# Documentation
worklog.md
README.md
QUICKSTART.md

# Local database files
/db/
*.db
*.db-journal

# Build artifacts
.next/

# Test files
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# Backup files
*.bak
*.backup

# OS files
.DS_Store
Thumbs.db
