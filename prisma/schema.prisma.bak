// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant' | 'tool' | 'thought'
  content        String
  toolName       String?
  toolArgs       String?
  toolResult     String?
  attachments    String? // JSON array of file metadata
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general") // 'preference' | 'fact' | 'goal' | 'income_idea' | ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings       UserSetting[]
  schedules      Schedule[]
  notifications  NotificationLog[]
  customSubagents CustomSubagent[]
}

model UserSetting {
  id      String @id @default(cuid())
  userId  String
  key     String
  value   String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model IncomeEntry {
  id        String   @id @default(cuid())
  amount    Float
  source    String // 'Agent007' | 'manual' | 'AURORA' | 'VERTEX' | 'stripe' | 'paypal' | etc.
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  provider        String   // 'stripe' | 'paypal'
  providerTxId    String   // unique transaction id from provider (e.g. Stripe charge id)
  amount          Float    // in major currency units (e.g. dollars, not cents)
  currency        String   @default("USD")
  status          String   @default("succeeded") // 'succeeded' | 'pending' | 'refunded' | 'failed'
  customerEmail   String?
  customerName    String?
  productName     String?
  description     String?
  rawPayload      String   // full webhook payload as JSON string
  createdAt       DateTime @default(now())

  @@unique([provider, providerTxId])
  @@index([userId])
}

model KnowledgeDoc {
  id           String   @id @default(cuid())
  userId       String
  filename     String
  mimeType     String
  size         Int
  text         String   // full extracted text (up to ~500KB)
  chunkCount   Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model KnowledgeChunk {
  id           String   @id @default(cuid())
  docId        String
  userId       String
  content      String   // ~500-char chunk
  chunkIndex   Int
  // Simple keyword index — comma-separated tokens for LIKE-based search
  // (proper vector embeddings would require a pgvector extension)
  keywords     String   @default("")
  createdAt    DateTime @default(now())

  @@index([docId])
  @@index([userId])
}

model Schedule {
  id           String    @id @default(cuid())
  userId       String
  name         String
  prompt       String
  intervalMin  Int
  enabled      Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  lastConvId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'mission_complete' | 'mission_failed' | 'income_logged' | 'daily_summary'
  to        String
  subject   String
  body      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Pending manage actions — recorded before executing a <manage .../> tag so
 * that if the run fails mid-flight (network, server crash, etc.), the action
 * can be replayed on the next orchestrator run.
 *
 * Lifecycle: pending → executing → done | failed.
 * The `attrs` field is a JSON-stringified Record<string,string> matching the
 * attributes parsed from the <manage .../> tag.
 */
model PendingManageAction {
  id        String   @id @default(cuid())
  userId    String
  action    String
  attrs     String   // JSON
  status    String   @default("pending") // pending | executing | done | failed
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/**
 * Custom (user-created) sub-agent definitions. Built-in agents live in code
 * (see /src/lib/subagents.ts); custom agents are stored here and merged with
 * the built-in list at runtime. Built-in agents CANNOT be deleted (their DB
 * row's `id` would match a built-in id if the user creates an edit overlay),
 * but they CAN be edited via an overlay row referencing the built-in id.
 *
 * Convention:
 *   - Custom agents have ids that DO NOT collide with built-in ids.
 *   - Edit-overlays for built-in agents share the built-in id but have
 *     `isBuiltinOverlay=true`. The runtime prefers the overlay row when
 *     merging.
 */
model CustomSubagent {
  id              String   @id @default(cuid())
  userId          String
  name            String
  role            String
  specialty       String
  color           String
  icon            String   // lucide icon name (string; client maps to component)
  allowedTools    String   // JSON array of tool name strings
  systemPrompt    String
  enabled         Boolean  @default(true)
  isBuiltinOverlay Boolean @default(false) // true = this row overrides a built-in agent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model TwoFactorSecret {
  id              String   @id @default(cuid())
  userId          String
  method          String
  phoneNumber     String?
  email           String?
  secret          String?
  qrCodeUrl       String?
  backupCodes     String?
  enabled         Boolean  @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([method])
}

model PhoneConfig {
  id              String   @id @default(cuid())
  userId          String
  phoneNumber     String?
  whatsappNumber  String?
  email           String?
  smsEnabled      Boolean  @default(false)
  whatsappEnabled Boolean  @default(false)
  emailEnabled    Boolean  @default(false)
  whatsappProvider String?
  callmebotApiKey  String?
  callmebotNumber  String?
  baileysSessionStatus String?
  baileysLinkedNumber String?
  baileysLinkedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model IncomingCommand {
  id              String   @id @default(cuid())
  userId          String
  source          String
  fromNumber      String?
  fromEmail       String?
  command         String
  status          String   @default("pending")
  conversationId  String?
  result          String?
  receivedAt      DateTime @default(now())
  executedAt      DateTime?

  @@index([userId])
  @@index([status])
}

model BankAccount {
  id              String   @id @default(cuid())
  userId          String
  accountHolder   String
  bankName        String
  accountType     String   @default("checking")
  accountNumber   String
  routingNumber   String
  accountLast4    String
  bankCountry     String   @default("US")
  bankCurrency    String   @default("USD")
  verificationStatus String @default("pending")
  isPrimary       Boolean  @default(false)
  label           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model PayPalAccount {
  id              String   @id @default(cuid())
  userId          String
  email           String
  clientId        String?
  clientSecret    String?
  webhookId       String?
  isPrimary       Boolean  @default(false)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  service     String
  key         String
  baseUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([service])
}

model Customer {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   @default("lead")
  value       Float    @default(0)
  source      String?
  notes       String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  userId      String
  name        String
  channel     String
  status      String   @default("draft")
  budget      Float    @default(0)
  spent       Float    @default(0)
  leadsGenerated Int   @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Partnership {
  id          String   @id @default(cuid())
  userId      String
  partnerName String
  partnerType String
  status      String   @default("proposed")
  commissionRate Float @default(0)
  revenueGenerated Float @default(0)
  contactEmail String?
  contactPhone String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model BusinessStrategy {
  id          String   @id @default(cuid())
  userId      String
  phase       String
  title       String
  description String
  status      String   @default("planned")
  priority    String   @default("medium")
  progress    Float    @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([phase])
  @@index([status])
}

model MissionTracker {
  id              String   @id @default(cuid())
  userId          String
  metric          String
  currentValue    Float
  targetValue     Float
  withoutImprovements Float?
  withImprovements Float?
  unit            String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([metric])
}

model ServicePackage {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  category    String
  priceMonthly Float   @default(0)
  priceOneTime Float   @default(0)
  deliveryTime String?
  features    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model Opportunity {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  potential   Float?
  status      String   @default("new")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Prediction {
  id          String   @id @default(cuid())
  userId      String
  category    String
  prediction  String
  confidence  Float    @default(0.5)
  timeframe   String?
  outcome     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([category])
}

model SystemHealth {
  id           String   @id @default(cuid())
  userId       String
  component    String
  status       String   @default("healthy")
  details      String?
  autoRepaired Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([component])
}

model MLModel {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  features    String
  weights     String
  accuracy    Float    @default(0.0)
  trainSamples Int     @default(0)
  lastTrained DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model RiskRegister {
  id           String   @id @default(cuid())
  userId       String
  category     String
  description  String
  likelihood   Int      @default(3)
  impact       Int      @default(3)
  score        Int      @default(15)
  level        String   @default("medium")
  mitigations  String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model ComplianceCheck {
  id          String   @id @default(cuid())
  userId      String
  country     String
  regulation  String
  status      String   @default("pending")
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ContractDraft {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String
  parties     String
  terms       String
  status      String   @default("draft")
  riskScore   Int      @default(5)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
