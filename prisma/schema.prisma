generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  service   String
  key       String
  baseUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([service])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([action])
  @@index([userId])
}

model BankAccount {
  id                 String   @id @default(cuid())
  userId             String
  accountHolder      String
  bankName           String
  accountType        String   @default("checking")
  accountNumber      String
  routingNumber      String
  accountLast4       String
  bankCountry        String   @default("US")
  bankCurrency       String   @default("USD")
  verificationStatus String   @default("pending")
  isPrimary          Boolean  @default(false)
  label              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  @@index([userId])
}

model BusinessStrategy {
  id          String    @id @default(cuid())
  userId      String
  phase       String
  title       String
  description String
  status      String    @default("planned")
  priority    String    @default("medium")
  progress    Float     @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([status])
  @@index([phase])
  @@index([userId])
}

model ComplianceCheck {
  id         String   @id @default(cuid())
  userId     String
  country    String
  regulation String
  status     String   @default("pending")
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model ContractDraft {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  parties   String
  terms     String
  status    String   @default("draft")
  riskScore Int      @default(5)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([status])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Message   Message[]
}

model CustomSubagent {
  id               String   @id @default(cuid())
  userId           String
  name             String
  role             String
  specialty        String
  color            String
  icon             String
  allowedTools     String
  systemPrompt     String
  enabled          Boolean  @default(true)
  isBuiltinOverlay Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  status    String   @default("lead")
  value     Float    @default(0)
  source    String?
  notes     String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([status])
  @@index([userId])
}

model IncomeEntry {
  id        String   @id @default(cuid())
  amount    Float
  source    String
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model IncomingCommand {
  id             String    @id @default(cuid())
  userId         String
  source         String
  fromNumber     String?
  fromEmail      String?
  command        String
  status         String    @default("pending")
  conversationId String?
  result         String?
  receivedAt     DateTime  @default(now())
  executedAt     DateTime?

  @@index([status])
  @@index([userId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  docId      String
  userId     String
  content    String
  chunkIndex Int
  keywords   String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([docId])
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  mimeType   String
  size       Int
  text       String
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model MLModel {
  id           String    @id @default(cuid())
  userId       String
  name         String
  type         String
  features     String
  weights      String
  accuracy     Float     @default(0.0)
  trainSamples Int       @default(0)
  lastTrained  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([userId])
}

model MarketingCampaign {
  id             String    @id @default(cuid())
  userId         String
  name           String
  channel        String
  status         String    @default("draft")
  budget         Float     @default(0)
  spent          Float     @default(0)
  leadsGenerated Int       @default(0)
  conversions    Int       @default(0)
  revenue        Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  @@index([status])
  @@index([userId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolName       String?
  toolArgs       String?
  toolResult     String?
  attachments    String?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MissionTracker {
  id                  String   @id @default(cuid())
  userId              String
  metric              String
  currentValue        Float
  targetValue         Float
  withoutImprovements Float?
  withImprovements    Float?
  unit                String
  updatedAt           DateTime
  createdAt           DateTime @default(now())

  @@index([metric])
  @@index([userId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  to        String
  subject   String
  body      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Opportunity {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  potential   Float?
  status      String   @default("new")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([status])
  @@index([userId])
}

model Partnership {
  id               String   @id @default(cuid())
  userId           String
  partnerName      String
  partnerType      String
  status           String   @default("proposed")
  commissionRate   Float    @default(0)
  revenueGenerated Float    @default(0)
  contactEmail     String?
  contactPhone     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([status])
  @@index([userId])
}

model PayPalAccount {
  id           String   @id @default(cuid())
  userId       String
  email        String
  clientId     String?
  clientSecret String?
  webhookId    String?
  isPrimary    Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([userId])
}

model PendingManageAction {
  id        String   @id @default(cuid())
  userId    String
  action    String
  attrs     String
  status    String   @default("pending")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([status])
  @@index([userId])
}

model PhoneConfig {
  id                   String    @id @default(cuid())
  userId               String
  phoneNumber          String?
  whatsappNumber       String?
  email                String?
  smsEnabled           Boolean   @default(false)
  whatsappEnabled      Boolean   @default(false)
  emailEnabled         Boolean   @default(false)
  whatsappProvider     String?
  callmebotApiKey      String?
  callmebotNumber      String?
  baileysSessionStatus String?
  baileysLinkedNumber  String?
  baileysLinkedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime

  @@index([userId])
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  category   String
  prediction String
  confidence Float    @default(0.5)
  timeframe  String?
  outcome    String?
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([userId])
}

model RiskRegister {
  id          String   @id @default(cuid())
  userId      String
  category    String
  description String
  likelihood  Int      @default(3)
  impact      Int      @default(3)
  score       Int      @default(15)
  level       String   @default("medium")
  mitigations String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category])
  @@index([userId])
}

model Schedule {
  id          String    @id @default(cuid())
  userId      String
  name        String
  prompt      String
  intervalMin Int
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastConvId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServicePackage {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String
  category     String
  priceMonthly Float    @default(0)
  priceOneTime Float    @default(0)
  deliveryTime String?
  features     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([category])
  @@index([userId])
}

model SystemHealth {
  id           String   @id @default(cuid())
  userId       String
  component    String
  status       String   @default("healthy")
  details      String?
  autoRepaired Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([component])
  @@index([userId])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  providerTxId  String
  amount        Float
  currency      String   @default("USD")
  status        String   @default("succeeded")
  customerEmail String?
  customerName  String?
  productName   String?
  description   String?
  rawPayload    String
  createdAt     DateTime @default(now())

  @@unique([provider, providerTxId])
  @@index([userId])
}

model TwoFactorSecret {
  id          String    @id @default(cuid())
  userId      String
  method      String
  phoneNumber String?
  email       String?
  secret      String?
  qrCodeUrl   String?
  backupCodes String?
  enabled     Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([method])
  @@index([userId])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  CustomSubagent  CustomSubagent[]
  NotificationLog NotificationLog[]
  Schedule        Schedule[]
  UserSetting     UserSetting[]
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
