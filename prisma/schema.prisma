generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  service   String
  key       String
  baseUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([service])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([action])
  @@index([userId])
}

model BankAccount {
  id                 String   @id @default(cuid())
  userId             String
  accountHolder      String
  bankName           String
  accountType        String   @default("checking")
  accountNumber      String
  routingNumber      String
  accountLast4       String
  bankCountry        String   @default("US")
  bankCurrency       String   @default("USD")
  verificationStatus String   @default("pending")
  isPrimary          Boolean  @default(false)
  label              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt @default(now())

  @@index([userId])
}

model BusinessStrategy {
  id          String    @id @default(cuid())
  userId      String
  phase       String
  title       String
  description String
  status      String    @default("planned")
  priority    String    @default("medium")
  progress    Float     @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@index([status])
  @@index([phase])
  @@index([userId])
}

model ComplianceCheck {
  id         String   @id @default(cuid())
  userId     String
  country    String
  regulation String
  status     String   @default("pending")
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model ContractDraft {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  parties   String
  terms     String
  status    String   @default("draft")
  riskScore Int      @default(5)
  notes     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt @default(now())
  Transaction Transaction[]

  @@index([status])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String?
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  Message   Message[]

  @@index([userId])
}

model CustomSubagent {
  id               String   @id @default(cuid())
  userId           String
  name             String
  role             String
  specialty        String
  color            String
  icon             String
  allowedTools     String
  systemPrompt     String
  enabled          Boolean  @default(true)
  isBuiltinOverlay Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id          String        @id @default(cuid())
  userId      String
  name      String
  email     String?
  phone     String?
  company   String?
  status    String   @default("lead")
  value     Float    @default(0)
  source    String?
  notes     String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  Transaction Transaction[]

  @@index([status])
  @@index([userId])
}

model IncomeEntry {
  id        String   @id @default(cuid())
  amount    Float
  source    String
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model IncomingCommand {
  id             String    @id @default(cuid())
  userId         String
  source         String
  fromNumber     String?
  fromEmail      String?
  command        String
  status         String    @default("pending")
  conversationId String?
  result         String?
  receivedAt     DateTime  @default(now())
  executedAt     DateTime?

  @@index([status])
  @@index([userId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  docId      String
  userId     String
  content    String
  chunkIndex Int
  keywords   String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([docId])
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  mimeType   String
  size       Int
  text       String
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model MLModel {
  id           String    @id @default(cuid())
  userId       String
  name         String
  type         String
  features     String
  weights      String
  accuracy     Float     @default(0.0)
  trainSamples Int       @default(0)
  lastTrained  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt @default(now())

  @@index([userId])
}

model MarketingCampaign {
  id             String    @id @default(cuid())
  userId         String
  name           String
  channel        String
  status         String    @default("draft")
  budget         Float     @default(0)
  spent          Float     @default(0)
  leadsGenerated Int       @default(0)
  conversions    Int       @default(0)
  revenue        Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolName       String?
  toolArgs       String?
  toolResult     String?
  attachments    String?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MissionTracker {
  id                  String   @id @default(cuid())
  userId              String
  metric              String
  currentValue        Float
  targetValue         Float
  withoutImprovements Float?
  withImprovements    Float?
  unit                String
  updatedAt           DateTime @updatedAt @default(now())
  createdAt           DateTime @default(now())

  @@index([metric])
  @@index([userId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  to        String
  subject   String
  body      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Opportunity {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  potential   Float?
  status      String   @default("new")
  source      String?
  url         String?
  riskScore   Int?
  estIncome   Float?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model Partnership {
  id               String   @id @default(cuid())
  userId           String
  partnerName      String
  partnerType      String
  status           String   @default("proposed")
  commissionRate   Float    @default(0)
  revenueGenerated Float    @default(0)
  contactEmail     String?
  contactPhone     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model PayPalAccount {
  id           String   @id @default(cuid())
  userId       String
  email        String
  clientId     String?
  clientSecret String?
  webhookId    String?
  isPrimary    Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([userId])
}

model PendingManageAction {
  id        String   @id @default(cuid())
  userId    String
  action    String
  attrs     String
  status    String   @default("pending")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model PhoneConfig {
  id                   String    @id @default(cuid())
  userId               String
  phoneNumber          String?
  whatsappNumber       String?
  email                String?
  smsEnabled           Boolean   @default(false)
  whatsappEnabled      Boolean   @default(false)
  emailEnabled         Boolean   @default(false)
  whatsappProvider     String?
  callmebotApiKey      String?
  callmebotNumber      String?
  baileysSessionStatus String?
  baileysLinkedNumber  String?
  baileysLinkedAt      DateTime?
  emailImapHost        String?
  emailImapPort        String?
  emailImapUser        String?
  emailImapPassword    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt @default(now())

  @@index([userId])
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  category   String
  prediction String
  confidence Float    @default(0.5)
  timeframe  String?
  outcome    String?
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([userId])
}

model RiskRegister {
  id          String   @id @default(cuid())
  userId      String
  category    String
  description String
  likelihood  Int      @default(3)
  impact      Int      @default(3)
  score       Int      @default(15)
  level       String   @default("medium")
  mitigations String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([category])
  @@index([userId])
}

model Schedule {
  id          String    @id @default(cuid())
  userId      String
  name        String
  prompt      String
  intervalMin Int
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastConvId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServicePackage {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String
  category     String
  priceMonthly Float    @default(0)
  priceOneTime Float    @default(0)
  deliveryTime String?
  features     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([category])
  @@index([userId])
}

model SystemHealth {
  id           String   @id @default(cuid())
  userId       String
  component    String
  status       String   @default("healthy")
  details      String?
  autoRepaired Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([component])
  @@index([userId])
}

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  provider      String
  providerTxId  String
  amount        Float
  currency      String    @default("USD")
  status        String    @default("succeeded")
  customerEmail String?
  customerName  String?
  productName   String?
  description   String?
  rawPayload    String
  ventureId     String?
  customerId    String?
  Customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([provider, providerTxId])
  @@index([userId])
  @@index([ventureId])
  @@index([customerId])
}

model TwoFactorSecret {
  id          String    @id @default(cuid())
  userId      String
  method      String
  phoneNumber String?
  email       String?
  secret      String?
  qrCodeUrl   String?
  backupCodes String?
  enabled     Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@index([method])
  @@index([userId])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt @default(now())
  CustomSubagent  CustomSubagent[]
  NotificationLog NotificationLog[]
  Schedule        Schedule[]
  UserSetting     UserSetting[]
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Experiment {
  id          String   @id @default(cuid())
  userId      String
  name        String
  status      String   @default("pending")
  hypothesis  String?
  variable    String?
  control     String?
  variant     String?
  metric      String?
  startDate   DateTime?
  endDate     DateTime?
  results     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  @@index([userId])
}

model PlatformConnection {
  id            String   @id @default(cuid())
  userId        String
  platform      String
  accountName   String
  apiKey        String?
  apiSecret     String?
  accessToken   String?
  connected     Boolean  @default(false)
  metadata      String?
  lastSync      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())
  @@index([userId])
  @@index([platform])
}

model RiskProfile {
  id                String   @id @default(cuid())
  userId            String
  riskTolerance     String   @default("moderate")
  investmentHorizon String?
  maxInvestment     Float?
  timeHorizon       String?
  preferredMarkets  String?
  avoidCategories   String?
  monthlyIncome     Float?
  monthlyExpenses   Float?
  emergencyFund     Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())
  @@index([userId])
}

model ScalingPlan {
  id                String   @id @default(cuid())
  userId            String
  name              String?
  asset             String?
  currentLevel      String?
  targetLevel       String?
  strategy          String?
  timeline          String?
  estimatedCost     Float?
  estimatedReturn   Float?
  riskLevel         String?
  status            String?
  bottlenecks       String?
  strategies        String?
  projectedTimeline String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())
  @@index([userId])
}

model SentimentLog {
  id         String   @id @default(cuid())
  userId     String?
  source     String?
  sentiment  String?
  score      Float?
  mood       String?
  confidence Float?
  trigger    String?
  context    String?
  text       String?
  url        String?
  createdAt  DateTime @default(now())
  @@index([userId])
  @@index([source])
}

/// Immutable proof of a meaningful autonomous execution.
model ExecutionReceipt {
  id               String   @id @default(cuid())
  missionId        String
  userId           String?
  actorId          String
  actorType        String
  action           String
  status           String
  idempotencyKey   String
  requestHash      String?
  inputReference   String?
  outputReference  String?
  errorCode        String?
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  recordHash       String
  metadata         String?

  @@unique([missionId, idempotencyKey])
  @@index([missionId, createdAt])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

/// Versioned, append-only evidence bundle for a mission.
model EvidenceLedger {
  id             String   @id @default(cuid())
  missionId      String
  userId         String?
  idempotencyKey String
  version        Int
  title          String
  status         String   @default("draft")
  previousHash   String?
  contentHash    String
  createdAt      DateTime @default(now())
  Source         EvidenceSource[]
  Claim          EvidenceClaim[]

  @@unique([missionId, idempotencyKey])
  @@unique([missionId, version])
  @@index([missionId, createdAt])
  @@index([status, createdAt])
}

/// Provenance record for an externally retrieved evidence payload.
model EvidenceSource {
  id             String         @id @default(cuid())
  ledgerId       String
  provider       String
  sourceUrl      String
  retrievedAt    DateTime
  rawEvidenceRef String
  rawEvidenceHash String
  requestHash    String?
  createdAt      DateTime       @default(now())
  Ledger         EvidenceLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  Claim          EvidenceClaim[]

  @@index([ledgerId, retrievedAt])
  @@index([provider, retrievedAt])
  @@unique([ledgerId, sourceUrl, rawEvidenceHash])
}

/// Atomic claim record linked to evidence provenance and confidence.
model EvidenceClaim {
  id               String          @id @default(cuid())
  ledgerId         String
  sourceId         String?
  claimKey         String
  claimText        String
  classification   String
  confidence       Float
  verificationStatus String
  notes            String?
  createdAt        DateTime        @default(now())
  Ledger           EvidenceLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  Source           EvidenceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([ledgerId, claimKey])
  @@index([ledgerId, verificationStatus])
  @@index([sourceId])
}
