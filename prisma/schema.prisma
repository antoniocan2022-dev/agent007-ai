// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant' | 'tool' | 'thought'
  content        String
  toolName       String?
  toolArgs       String?
  toolResult     String?
  attachments    String? // JSON array of file metadata
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general") // 'preference' | 'fact' | 'goal' | 'income_idea' | ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings       UserSetting[]
  schedules      Schedule[]
  notifications  NotificationLog[]
}

model UserSetting {
  id      String @id @default(cuid())
  userId  String
  key     String
  value   String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model IncomeEntry {
  id        String   @id @default(cuid())
  amount    Float
  source    String // 'Agent007' | 'manual' | 'AURORA' | 'VERTEX' | etc.
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Schedule {
  id           String    @id @default(cuid())
  userId       String
  name         String
  prompt       String
  intervalMin  Int
  enabled      Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  lastConvId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'mission_complete' | 'mission_failed' | 'income_logged' | 'daily_summary'
  to        String
  subject   String
  body      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
