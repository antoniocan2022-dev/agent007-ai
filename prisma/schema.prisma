generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  service   String
  key       String
  baseUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([service])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([action])
  @@index([userId])
}

model BankAccount {
  id                 String   @id @default(cuid())
  userId             String
  accountHolder      String
  bankName           String
  accountType        String   @default("checking")
  accountNumber      String
  routingNumber      String
  accountLast4       String
  bankCountry        String   @default("US")
  bankCurrency       String   @default("USD")
  verificationStatus String   @default("pending")
  isPrimary          Boolean  @default(false)
  label              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt @default(now())

  @@index([userId])
}

model BusinessStrategy {
  id          String    @id @default(cuid())
  userId      String
  phase       String
  title       String
  description String
  status      String    @default("planned")
  priority    String    @default("medium")
  progress    Float     @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([status])
  @@index([phase])
  @@index([userId])
}

model ComplianceCheck {
  id         String   @id @default(cuid())
  userId     String
  country    String
  regulation String
  status     String   @default("pending")
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model ContractDraft {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  parties   String
  terms     String
  status    String   @default("draft")
  riskScore Int      @default(5)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  // UPGRADE #173 fix #7: userId field — referenced by src/app/api/users/
  // [id]/route.ts:22,23 + src/lib/self-repair.ts:227,233 (5 errors). The
  // table didn't have this column — the routes that filter by user had
  // to scan all conversations instead. Now it's indexed and filterable.
  userId    String?
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt @default(now())
  Message   Message[]

  @@index([userId])
}

model CustomSubagent {
  id               String   @id @default(cuid())
  userId           String
  name             String
  role             String
  specialty        String
  color            String
  icon             String
  allowedTools     String
  systemPrompt     String
  enabled          Boolean  @default(true)
  isBuiltinOverlay Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  status    String   @default("lead")
  value     Float    @default(0)
  source    String?
  notes     String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model IncomeEntry {
  id        String   @id @default(cuid())
  amount    Float
  source    String
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model IncomingCommand {
  id             String    @id @default(cuid())
  userId         String
  source         String
  fromNumber     String?
  fromEmail      String?
  command        String
  status         String    @default("pending")
  conversationId String?
  result         String?
  receivedAt     DateTime  @default(now())
  executedAt     DateTime?

  @@index([status])
  @@index([userId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  docId      String
  userId     String
  content    String
  chunkIndex Int
  keywords   String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([docId])
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  mimeType   String
  size       Int
  text       String
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model MLModel {
  id           String    @id @default(cuid())
  userId       String
  name         String
  type         String
  features     String
  weights      String
  accuracy     Float     @default(0.0)
  trainSamples Int       @default(0)
  lastTrained  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([userId])
}

model MarketingCampaign {
  id             String    @id @default(cuid())
  userId         String
  name           String
  channel        String
  status         String    @default("draft")
  budget         Float     @default(0)
  spent          Float     @default(0)
  leadsGenerated Int       @default(0)
  conversions    Int       @default(0)
  revenue        Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolName       String?
  toolArgs       String?
  toolResult     String?
  attachments    String?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MissionTracker {
  id                  String   @id @default(cuid())
  userId              String
  metric              String
  currentValue        Float
  targetValue         Float
  withoutImprovements Float?
  withImprovements    Float?
  unit                String
  updatedAt           DateTime @updatedAt @default(now())
  createdAt           DateTime @default(now())

  @@index([metric])
  @@index([userId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  to        String
  subject   String
  body      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Opportunity {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  potential   Float?
  status      String   @default("new")
  // UPGRADE #173 fix #7: Added source field — used by
  // src/app/api/opportunities/route.ts:15
  source      String?
  // UPGRADE #173 fix #7: extra fields used by opportunities/route.ts:15
  url         String?
  riskScore   Int?
  estIncome   Float?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model Partnership {
  id               String   @id @default(cuid())
  userId           String
  partnerName      String
  partnerType      String
  status           String   @default("proposed")
  commissionRate   Float    @default(0)
  revenueGenerated Float    @default(0)
  contactEmail     String?
  contactPhone     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model PayPalAccount {
  id           String   @id @default(cuid())
  userId       String
  email        String
  clientId     String?
  clientSecret String?
  webhookId    String?
  isPrimary    Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([userId])
}

model PendingManageAction {
  id        String   @id @default(cuid())
  userId    String
  action    String
  attrs     String
  status    String   @default("pending")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([status])
  @@index([userId])
}

model PhoneConfig {
  id                   String    @id @default(cuid())
  userId               String
  phoneNumber          String?
  whatsappNumber       String?
  email                String?
  smsEnabled           Boolean   @default(false)
  whatsappEnabled      Boolean   @default(false)
  emailEnabled         Boolean   @default(false)
  whatsappProvider     String?
  callmebotApiKey      String?
  callmebotNumber      String?
  baileysSessionStatus String?
  baileysLinkedNumber  String?
  baileysLinkedAt      DateTime?
  // UPGRADE #173 fix #2: Added emailImap* fields so phone-config POST
  // can write IMAP settings and commands/poll-email can read them.
  // Before: phone-config route.ts:42 listed these 4 fields as writable,
  // but Prisma schema didn't have them → runtime error
  // "Unknown field emailImapHost" when saving IMAP settings.
  // After: schema matches the route's expected fields. The poll-email
  // route reads them to connect to IMAP servers for inbound email
  // commands.
  emailImapHost         String?
  emailImapPort         String?
  emailImapUser         String?
  emailImapPassword     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime @updatedAt @default(now())

  @@index([userId])
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  category   String
  prediction String
  confidence Float    @default(0.5)
  timeframe  String?
  outcome    String?
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([userId])
}

model RiskRegister {
  id          String   @id @default(cuid())
  userId      String
  category    String
  description String
  likelihood  Int      @default(3)
  impact      Int      @default(3)
  score       Int      @default(15)
  level       String   @default("medium")
  mitigations String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([category])
  @@index([userId])
}

model Schedule {
  id          String    @id @default(cuid())
  userId      String
  name        String
  prompt      String
  intervalMin Int
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastConvId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServicePackage {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String
  category     String
  priceMonthly Float    @default(0)
  priceOneTime Float    @default(0)
  deliveryTime String?
  features     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([category])
  @@index([userId])
}

model SystemHealth {
  id           String   @id @default(cuid())
  userId       String
  component    String
  status       String   @default("healthy")
  details      String?
  autoRepaired Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([component])
  @@index([userId])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  providerTxId  String
  amount        Float
  currency      String   @default("USD")
  status        String   @default("succeeded")
  customerEmail String?
  customerName  String?
  productName   String?
  description   String?
  rawPayload    String
  createdAt     DateTime @default(now())

  @@unique([provider, providerTxId])
  @@index([userId])
}

model TwoFactorSecret {
  id          String    @id @default(cuid())
  userId      String
  method      String
  phoneNumber String?
  email       String?
  secret      String?
  qrCodeUrl   String?
  backupCodes String?
  enabled     Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([method])
  @@index([userId])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime @updatedAt @default(now())
  CustomSubagent  CustomSubagent[]
  NotificationLog NotificationLog[]
  Schedule        Schedule[]
  UserSetting     UserSetting[]
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ════════════════════════════════════════════════════════════════
// UPGRADE #173 fix #7: Add missing models so the 63 pre-existing TS
// errors (which were silently ignored by next.config.ts:
// ignoreBuildErrors=true) become actual code that compiles. These
// models are referenced by routes that were built before the schema
// was finalized. They're minimal models — only the fields the routes
// actually use. Each one is used by at least one route or lib file.
// ════════════════════════════════════════════════════════════════

// Referenced by:
//   src/app/api/experiments/route.ts (3 places)
//   src/app/api/risk-profile/route.ts (uses riskProfile, but we add
//     this generic Experiment model too)
model Experiment {
  id          String   @id @default(cuid())
  userId      String
  name        String
  status      String   @default("pending")
  hypothesis  String?
  // UPGRADE #173 fix #7: extra fields used by experiments/route.ts:15
  variable    String?
  control     String?
  variant     String?
  metric      String?
  startDate   DateTime?
  endDate     DateTime?
  results     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  @@index([userId])
}

// Referenced by:
//   src/app/api/payment-accounts/route.ts (4 places)
//   src/app/api/payment-accounts/verify/route.ts (2 places)
//   src/app/api/platforms/route.ts (3 places)
//   src/app/api/users/[id]/route.ts (1 place)
//   src/lib/improvement-actions.ts (referenced indirectly)
model PlatformConnection {
  id            String   @id @default(cuid())
  userId        String
  platform      String
  accountName   String
  apiKey        String?
  apiSecret     String?
  // UPGRADE #173 fix #7: accessToken field used by platforms/route.ts:11,18
  accessToken   String?
  connected     Boolean  @default(false)
  metadata      String?
  lastSync      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())
  @@index([userId])
  @@index([platform])
}

// Referenced by:
//   src/app/api/risk-profile/route.ts (5 places)
//   src/lib/improvement-actions.ts (1 place)
model RiskProfile {
  id                String   @id @default(cuid())
  userId            String
  riskTolerance     String   @default("moderate")
  investmentHorizon String?
  // UPGRADE #173 fix #7: extra fields used by risk-profile/route.ts:17,18
  maxInvestment     Float?
  timeHorizon       String?
  preferredMarkets  String?
  avoidCategories   String?
  monthlyIncome     Float?
  monthlyExpenses   Float?
  emergencyFund     Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())
  @@index([userId])
}

// Referenced by:
//   src/app/api/scaling/route.ts (3 places)
model ScalingPlan {
  id              String   @id @default(cuid())
  userId          String
  // UPGRADE #173 fix #7: extra fields used by scaling/route.ts:15
  name            String?
  asset           String?
  currentLevel     String?
  targetLevel      String?
  strategy        String?
  timeline        String?
  estimatedCost   Float?
  estimatedReturn Float?
  riskLevel       String?
  status          String?
  bottlenecks      String?
  strategies       String?
  projectedTimeline String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())
  @@index([userId])
}

// Referenced by:
//   src/lib/advanced-capabilities.ts (1 place)
//   src/lib/advanced-tools.ts (1 place)
//   src/lib/intelligence-tools.ts (1 place)
model SentimentLog {
  id          String   @id @default(cuid())
  userId      String?
  // UPGRADE #173 fix #7: source + sentiment made optional — the 3 callers
  // (advanced-capabilities.ts, advanced-tools.ts, intelligence-tools.ts)
  // don't always provide them (they only log mood+confidence+trigger+context).
  // Was required in the original #52 schema, but never enforced by callers.
  source      String?
  sentiment   String?
  score       Float?
  // UPGRADE #173 fix #7: mood field used by advanced-capabilities.ts:312,
  // advanced-tools.ts:478, intelligence-tools.ts:223
  mood        String?
  // UPGRADE #173 fix #7: confidence field used by same 3 files.
  confidence  Float?
  // UPGRADE #173 fix #7: trigger field used by same 3 files (line 312/480/225)
  trigger     String?
  // UPGRADE #173 fix #7: context field used by same 3 files (line 312/481/226)
  context     String?
  text        String?
  url         String?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([source])
}


model ArtifactLedger {
  id                String    @id @default(cuid())
  artifactId        String    @unique
  missionId         String?
  ventureId         String?
  parentArtifactId  String?
  stageId           String?
  artifactType      String
  name              String
  version           Int       @default(1)
  status            String    @default("submitted")
  producerAgentId   String
  consumerAgentId   String?
  sourceRef         String?
  artifactValue     String?
  contentHash       String
  verificationScore Float?
  verifiedBy        String?
  verifiedAt        DateTime?
  metadata          String?
  handoffHistory    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([missionId])
  @@index([ventureId])
  @@index([parentArtifactId])
  @@index([producerAgentId])
  @@index([consumerAgentId])
  @@index([status])
}
