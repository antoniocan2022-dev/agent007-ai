# Copy this file to .env and fill in real values. .env is gitignored (see .gitignore) --
# never commit real secrets.

# Postgres connection string. For local dev with the included docker-compose.yml:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent007_dev
# For a hosted Postgres (Neon, Supabase, RDS, Prisma Postgres, ...), use the connection
# string your provider gives you instead -- the raw-TCP "postgresql://" form works fine
# from a real machine; it does not work from inside this repo's Claude Code remote sandbox
# (that environment's network policy blocks raw-TCP database connections and this specific
# kind of egress -- see the docker-compose path above for sandbox-compatible local dev).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent007_dev

# Auth/session secret. Any long random string for local dev; generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-change-me

# Owner/seed identity used by scripts/bootstrap-owner-data.ts and db:reconcile.
OWNER_EMAIL=you@example.com
SEED_EMAIL=you@example.com
OWNER_BOOTSTRAP_PASSWORD=change-me-strong-password

# --- Optional: only needed for specific features. Both fail closed and are reported as
# --- honestly unconfigured (via the CEO capability briefing) when absent -- not required
# --- to run the app or its test suite.

# Enables audio/video transcription in the knowledge-base ingestion pipeline (Groq Whisper).
GROQ_API_KEY=

# Enables embedding-based semantic search recovery in the knowledge base and CEO memory.
MISTRAL_API_KEY=

# --- Search: web_search and page_reader already work with zero configuration (DuckDuckGo,
# --- honest failure if unreachable). Every key below upgrades search quality/reliability and is
# --- picked up automatically the moment it's set -- no code change needed, and
# --- multi_search_compare auto-upgrades its default engine list to use the best ones configured.

# Best overall upgrade: AI-optimized search built for agents, cited results. Free tier available.
# https://tavily.com
TAVILY_API_KEY=

# Real web search index, also upgrades the web_search fallback chain. Free tier available.
# https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Neural/semantic search -- finds conceptually related content, not just keyword matches.
# https://exa.ai
EXA_API_KEY=

# Structured Google search results. https://serpapi.com
SERPAPI_API_KEY=

# Real-time news search across 80,000+ sources. https://newsapi.org
NEWSAPI_KEY=

# Real cited, synthesized web answers (powers perplexity_ai_search for real).
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Real You.com search API (powers you_com_search for real). https://api.you.com
YDC_API_KEY=

# Real Google-sourced results via Google Programmable Search (powers google_ai_search for real).
# Requires both. https://programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Finance: yahoo_finance and coingecko already work with zero configuration (free, no key).
# --- Every key below adds a real data source with no code change needed once set.

# Real-time-ish stock quotes, generous free tier (recommended over Alpha Vantage below).
# https://finnhub.io/register
FINNHUB_API_KEY=

# Stock/forex/crypto quotes -- free tier is thin (25 requests/day).
# https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# Official US Federal Reserve macroeconomic data series -- unlimited, free.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Fundamentals (income/balance/cash-flow statements, ratios) via roic_financials.
# https://roic.ai
ROIC_API_KEY=

# Daily OHLCV prices via tiingo_daily -- free tier available.
# https://www.tiingo.com
TIINGO_API_KEY=

# Corporate actions (splits/dividends) and aggregates via polygon_corporate_actions -- free tier available.
# https://polygon.io
POLYGON_API_KEY=

# --- Web crawling: firecrawl_crawl and spider_crawl also work keyless (rate-limited); a key raises
# --- the limit and is required for larger crawl jobs.
# https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# https://spider.cloud
SPIDER_API_KEY=
