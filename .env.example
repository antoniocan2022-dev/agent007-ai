# Copy this file to .env and fill in real values. .env is gitignored (see .gitignore) --
# never commit real secrets.

# Postgres connection string. For local dev with the included docker-compose.yml:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent007_dev
# For a hosted Postgres (Neon, Supabase, RDS, Prisma Postgres, ...), use the connection
# string your provider gives you instead -- the raw-TCP "postgresql://" form works fine
# from a real machine; it does not work from inside this repo's Claude Code remote sandbox
# (that environment's network policy blocks raw-TCP database connections and this specific
# kind of egress -- see the docker-compose path above for sandbox-compatible local dev).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent007_dev

# Auth/session secret. Any long random string for local dev; generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-change-me

# Owner/seed identity used by scripts/bootstrap-owner-data.ts and db:reconcile.
OWNER_EMAIL=you@example.com
SEED_EMAIL=you@example.com
OWNER_BOOTSTRAP_PASSWORD=change-me-strong-password

# --- Optional: only needed for specific features. Both fail closed and are reported as
# --- honestly unconfigured (via the CEO capability briefing) when absent -- not required
# --- to run the app or its test suite.

# Enables audio/video transcription in the knowledge-base ingestion pipeline (Groq Whisper).
GROQ_API_KEY=

# Enables embedding-based semantic search recovery in the knowledge base and CEO memory.
MISTRAL_API_KEY=
