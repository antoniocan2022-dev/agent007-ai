  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "if [ \"$AGENT007_RELEASE_SCHEMA_RECONCILE\" = \"1\" ]; then bun run db:reconcile; fi && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
