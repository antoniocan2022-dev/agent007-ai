    "audit:coherence": "bun scripts/repository-coherence-audit.ts",
    "audit:ceo-lifecycle": "bun scripts/ceo-cognitive-lifecycle-audit.ts && bun scripts/ceo-phase-0-10-audit.ts",
    "audit:ceo-phase-1-8": "bun scripts/ceo-phase-1-8-audit.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:reconcile": "bun src/lib/reconcile-production-schema.ts",
    "db:bootstrap": "bun scripts/bootstrap-owner-data.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
