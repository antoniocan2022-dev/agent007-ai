{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": true
  },
  "installCommand": "bun install",
  "buildCommand": "bash scripts/vercel-build.sh",
  "functions": {
    "src/app/api/agent/route.ts": { "maxDuration": 300 },
    "src/app/api/monitor/qa/route.ts": { "maxDuration": 60 },
    "src/app/api/monitor/external/route.ts": { "maxDuration": 60 },
    "src/app/api/owner-backup/route.ts": { "maxDuration": 60 },
    "src/app/api/**/route.ts": { "maxDuration": 60 }
  },
  "regions": ["iad1"]
}
